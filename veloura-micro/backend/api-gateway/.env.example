# Port the gateway itself listens on.
# The frontend's VITE_API_URL should point at this (http://localhost:5000/api),
# exactly like the original single-server backend.
PORT=5000

# Where each microservice is running.
# Change these to real URLs when each service is deployed separately
# (e.g. https://veloura-product-service.onrender.com)
PRODUCT_SERVICE_URL=http://localhost:5001
CART_SERVICE_URL=http://localhost:5002
ORDER_SERVICE_URL=http://localhost:5003

# Comma separated list of allowed origins for CORS (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173
