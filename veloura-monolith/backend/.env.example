# MongoDB Atlas connection string (one database for the whole app).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/veloura?retryWrites=true&w=majority

# Port the monolith listens on
PORT=5000

# Allowed CORS origin (only matters if the frontend runs on a different port, e.g. Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
